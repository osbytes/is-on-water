dist
node_modules
.tap

# Cached upstream sources (hundreds of MB–tens of GB each)
data/_osm/
data/_hydrolakes/
data/_osm_inland/
data/_geofabrik/

# Intermediate GDAL output and downloaded (non-bundled) layers
data/_*.tmp.fgb
data/_layer-cache/
data/layers/*.fgb
# Global rivers/ponds exceed git limits; served from the data-v1 release
data/layers/rivers-*.fgb.gz
data/layers/ponds-*.fgb.gz

.env
.env.*
!.env.example